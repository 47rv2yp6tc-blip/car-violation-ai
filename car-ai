<!DOCTYPE html>
<html lang="zh-Hant">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="汽車違規拍照辨識與預估罰鍰的 AI 學習原型" />
  <title>RoadLens AI｜汽車違規辨識</title>
  <style>
    :root { --ink:#10233f; --muted:#65758b; --line:#dce5ed; --bg:#f6f9fc; --blue:#1769e0; --blue-dark:#0c4da8; --red:#e85b58; --green:#147d67; --yellow:#f1ad3d; }
    * { box-sizing:border-box; }
    body { margin:0; background:var(--bg); color:var(--ink); font-family:Inter, "Noto Sans TC", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
    button, input { font:inherit; }
    button { cursor:pointer; }
    .shell { max-width:1160px; margin:auto; padding:0 28px 60px; }
    header { display:flex; align-items:center; justify-content:space-between; padding:25px 0; }
    .brand { display:flex; align-items:center; gap:12px; font-weight:800; font-size:19px; letter-spacing:.02em; }
    .brand-mark { width:39px; height:39px; display:grid; place-items:center; border-radius:12px; color:white; background:var(--blue); box-shadow:0 7px 18px #1769e03d; font-size:20px; }
    .badge { color:var(--blue-dark); background:#eaf2ff; padding:8px 14px; border-radius:99px; font-size:13px; font-weight:700; }
    .hero { display:grid; grid-template-columns:1.08fr .92fr; gap:70px; align-items:center; padding:54px 0 62px; }
    .eyebrow { color:var(--blue); text-transform:uppercase; letter-spacing:.13em; font-size:12px; font-weight:800; margin:0 0 18px; }
    h1 { font-size:clamp(38px, 5vw, 64px); line-height:1.12; letter-spacing:-.055em; margin:0 0 22px; }
    h1 span { color:var(--blue); }
    .lead { color:var(--muted); font-size:18px; line-height:1.8; max-width:560px; margin:0 0 32px; }
    .actions { display:flex; flex-wrap:wrap; gap:12px; }
    .btn { border:0; border-radius:13px; padding:15px 23px; font-weight:800; transition:.2s; }
    .btn:hover { transform:translateY(-2px); }
    .primary { color:white; background:var(--blue); box-shadow:0 8px 18px #1769e03d; }
    .secondary { color:var(--ink); background:white; border:1px solid var(--line); }
    .visual { min-height:330px; border-radius:28px; background:linear-gradient(140deg,#dcecff,#edf6ff 62%,#d7eff0); position:relative; overflow:hidden; display:grid; place-items:center; box-shadow:0 22px 50px #174b7c17; }
    .visual:before,.visual:after { content:""; position:absolute; border-radius:50%; background:#ffffff70; }
    .visual:before { width:260px;height:260px; top:-120px;right:-70px; }.visual:after { width:220px;height:220px;bottom:-130px;left:-70px; }
    .road { position:absolute; width:120%; height:110px; bottom:38px; background:#8aa0ae; transform:rotate(-10deg); border-top:6px solid #f5d36e; border-bottom:4px solid #ffffff; }
    .car { position:relative; z-index:1; font-size:130px; filter:drop-shadow(0 18px 10px #315d6c55); transform:translateY(-9px); }
    .scan { position:absolute; z-index:2; width:210px; height:210px; border:2px solid var(--blue); border-radius:20px; box-shadow:0 0 0 999px #ffffff18; }
    .scan:after { content:"AI SCAN"; position:absolute; left:10px; top:-25px; color:var(--blue); font-size:11px; font-weight:900; letter-spacing:.12em; }
    .stats { display:grid; grid-template-columns:repeat(3,1fr); gap:14px; margin:0 0 62px; }
    .stat { background:white; border:1px solid var(--line); border-radius:17px; padding:19px 21px; }.stat strong { display:block; font-size:23px; margin-bottom:5px; }.stat span { color:var(--muted); font-size:13px; }
    .workspace { display:grid; grid-template-columns:1fr 1fr; gap:24px; align-items:start; }
    .panel { background:white; border:1px solid var(--line); border-radius:21px; padding:27px; box-shadow:0 8px 26px #203e5c08; }
    .panel h2 { margin:0 0 7px; font-size:21px; }.sub { color:var(--muted); font-size:14px; margin:0 0 22px; }
    .drop { border:1.5px dashed #a8bfd4; border-radius:16px; min-height:220px; display:grid; place-items:center; text-align:center; padding:20px; background:#fafdff; transition:.2s; }.drop.drag { background:#eaf3ff; border-color:var(--blue); }.drop input { display:none; }
    .upload-icon { width:57px;height:57px; border-radius:17px; background:#eaf2ff; display:grid;place-items:center; color:var(--blue); font-size:25px; margin:0 auto 14px; }.drop p { margin:6px 0; }.drop small { color:var(--muted); }.choose { color:var(--blue); font-weight:800; border:0; background:none; padding:0; }
    .preview { max-width:100%; max-height:230px; border-radius:12px; object-fit:cover; }.hidden { display:none !important; }
    .analyze { width:100%; margin-top:15px; }.analyze:disabled { opacity:.45; cursor:not-allowed; transform:none; }
    .empty { text-align:center; padding:70px 20px; color:var(--muted); }.empty-icon { font-size:42px; opacity:.45; margin-bottom:12px; }
    .result-head { display:flex; justify-content:space-between; align-items:start; border-bottom:1px solid var(--line); padding-bottom:18px; margin-bottom:17px; }.result-head h2 { margin:0; }.result-status { color:var(--green); font-size:12px; font-weight:800; background:#e7f7f1; border-radius:99px; padding:7px 10px; }
    .violation { border:1px solid var(--line); border-left:4px solid var(--red); border-radius:12px; padding:16px; margin-bottom:12px; }.violation-top { display:flex; justify-content:space-between; gap:10px; }.violation h3 { margin:0 0 8px; font-size:17px; }.fine { color:var(--red); font-weight:900; white-space:nowrap; }.law { color:var(--muted); font-size:13px; }.reason { font-size:14px; line-height:1.7; margin:12px 0; }.confidence { display:flex; align-items:center; gap:10px; color:var(--muted); font-size:12px; }.bar { flex:1; height:7px; background:#edf1f4; border-radius:99px; overflow:hidden; }.bar i { display:block; height:100%; background:var(--blue); border-radius:99px; }.total { display:flex; align-items:end; justify-content:space-between; background:#10233f; border-radius:14px; color:white; padding:18px 20px; margin-top:18px; }.total small { color:#aebed0; }.total strong { color:#ffd36b; font-size:26px; }
    .notice { margin-top:38px; padding:17px 20px; border-radius:13px; background:#fff8e8; color:#795a25; font-size:13px; line-height:1.7; }.notice b { color:#604514; }
    footer { color:#93a1b0; text-align:center; font-size:12px; padding-top:40px; }
    @media(max-width:800px) { .hero,.workspace { grid-template-columns:1fr; gap:30px; }.hero { padding-top:25px; }.visual { min-height:260px; }.stats { grid-template-columns:1fr; gap:9px; }.shell { padding:0 17px 40px; } header { padding:17px 0; }.badge { font-size:11px; }.panel { padding:20px; } }
  </style>
</head>
<body>
  <main class="shell">
    <header><div class="brand"><div class="brand-mark">⌁</div>RoadLens AI</div><div class="badge">學習展示原型 · Prototype</div></header>
    <section class="hero">
      <div><p class="eyebrow">Smart traffic analysis</p><h1>讓照片替你<br><span>看懂交通違規</span></h1><p class="lead">上傳或拍攝一張道路照片，AI 將協助辨識可能的汽車違規行為，並整理法規、信心程度與預估罰鍰。</p><div class="actions"><button class="btn primary" onclick="document.getElementById('photoInput').click()">▣　開始拍照／上傳</button><button class="btn secondary" onclick="document.getElementById('workspace').scrollIntoView({behavior:'smooth'})">了解使用方式　↓</button></div></div>
      <div class="visual"><div class="road"></div><div class="scan"></div><div class="car">🚙</div></div>
    </section>
    <section class="stats"><div class="stat"><strong>01</strong><span>上傳道路照片</span></div><div class="stat"><strong>02</strong><span>AI 分析影像特徵</span></div><div class="stat"><strong>03</strong><span>查看違規與預估罰鍰</span></div></section>
    <section id="workspace" class="workspace">
      <div class="panel"><h2>照片分析</h2><p class="sub">支援 JPG、PNG；建議照片包含完整車輛與道路環境。</p><div id="drop" class="drop"><input id="photoInput" type="file" accept="image/*" capture="environment"><div id="dropContent"><div class="upload-icon">↥</div><p><button class="choose" onclick="document.getElementById('photoInput').click()">選擇照片</button> 或拖曳至此</p><small>也可以直接使用手機相機拍攝</small></div><img id="preview" class="preview hidden" alt="待分析的道路照片"></div><button id="analyze" class="btn primary analyze" disabled>開始 AI 辨識</button><button id="reset" class="btn secondary analyze hidden">重新選擇照片</button></div>
      <div class="panel" id="results"><div class="empty"><div class="empty-icon">✦</div><strong>等待照片分析</strong><p>分析結果會顯示在這裡</p></div></div>
    </section>
    <div class="notice"><b>重要提醒：</b>本工具為學習與展示用途的 AI 原型，辨識結果與罰款金額僅供參考，可能因照片品質、地點及實際情況而有誤差，不應視為正式法律判定。請以主管機關最新公告及現場執法人員認定為準。</div>
    <footer>RoadLens AI · 讓道路更安全，讓判斷更透明</footer>
  </main>
  <script>
    const input=document.getElementById('photoInput'), drop=document.getElementById('drop'), preview=document.getElementById('preview'), dropContent=document.getElementById('dropContent'), analyze=document.getElementById('analyze'), reset=document.getElementById('reset'), results=document.getElementById('results');
    let selected=false;
    function loadFile(file){ if(!file || !file.type.startsWith('image/')) return; const reader=new FileReader(); reader.onload=e=>{ preview.src=e.target.result; preview.classList.remove('hidden'); dropContent.classList.add('hidden'); analyze.disabled=false; reset.classList.remove('hidden'); selected=true; }; reader.readAsDataURL(file); }
    input.addEventListener('change',e=>loadFile(e.target.files[0]));
    ['dragenter','dragover'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.add('drag')}));
    ['dragleave','drop'].forEach(ev=>drop.addEventListener(ev,e=>{e.preventDefault();drop.classList.remove('drag')}));
    drop.addEventListener('drop',e=>loadFile(e.dataTransfer.files[0]));
    reset.addEventListener('click',()=>{input.value='';preview.src='';preview.classList.add('hidden');dropContent.classList.remove('hidden');analyze.disabled=true;reset.classList.add('hidden');results.innerHTML='<div class="empty"><div class="empty-icon">✦</div><strong>等待照片分析</strong><p>分析結果會顯示在這裡</p></div>';});
    analyze.addEventListener('click',()=>{ if(!selected)return; analyze.disabled=true; analyze.textContent='分析中…'; results.innerHTML='<div class="empty"><div class="empty-icon">◌</div><strong>AI 正在分析照片</strong><p>正在比對道路標線、號誌與車輛位置…</p></div>'; setTimeout(()=>{ results.innerHTML='<div class="result-head"><div><h2>辨識結果</h2><p class="sub" style="margin:5px 0 0">根據照片可見特徵產生的預估</p></div><span class="result-status">分析完成</span></div><div class="violation"><div class="violation-top"><div><h3>疑似違規停車</h3><div class="law">道路交通管理處罰條例第 56 條</div></div><div class="fine">NT$ 600</div></div><p class="reason">車輛疑似停放於道路邊線外，且周邊未見明確合法停車標誌；車身位置與路側空間重疊。</p><div class="confidence"><span>AI 信心度</span><div class="bar"><i style="width:92%"></i></div><b>92%</b></div></div><div class="violation"><div class="violation-top"><div><h3>無法確定：是否妨礙通行</h3><div class="law">需更多角度或現場資訊判斷</div></div><div class="fine">—</div></div><p class="reason">照片中無法清楚確認剩餘車道寬度及實際通行狀況，因此不強制做出違規判斷。</p><div class="confidence"><span>AI 信心度</span><div class="bar"><i style="width:41%;background:var(--yellow)"></i></div><b>41%</b></div></div><div class="total"><div><small>預估總罰款</small><br><span>已計入可確認的違規項目</span></div><strong>NT$ 600</strong></div>'; analyze.disabled=false; analyze.textContent='重新分析'; },1100); });
  </script>
</body>
</html>
